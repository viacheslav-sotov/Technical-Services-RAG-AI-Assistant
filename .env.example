# =============================================================================
# Technical Services RAG Assistant - Environment Configuration
# -----------------------------------------------------------------------------
# Copy this file to ".env" and fill in the values you need.
#   cp .env.example .env        (macOS/Linux)
#   Copy-Item .env.example .env (Windows PowerShell)
#
# NOTE: Never commit your real ".env" file. It is git-ignored on purpose.
# =============================================================================

# -----------------------------------------------------------------------------
# App / server
# -----------------------------------------------------------------------------
APP_NAME="Technical Services RAG Assistant"
ENVIRONMENT=development            # development | production
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR

# Comma-separated list of allowed CORS origins. Use "*" only for local dev.
CORS_ORIGINS=http://localhost:8501,http://localhost:3000

# -----------------------------------------------------------------------------
# Admin authentication (HTTP Basic). Used to protect /admin/* and destructive ops.
# CHANGE THESE before deploying to production.
# -----------------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please

# -----------------------------------------------------------------------------
# Rate limiting (per client IP). Format examples: "30/minute", "1000/day".
# -----------------------------------------------------------------------------
RATE_LIMIT_CHAT=20/minute
RATE_LIMIT_UPLOAD=10/minute
RATE_LIMIT_DEFAULT=60/minute

# -----------------------------------------------------------------------------
# LLM provider
# -----------------------------------------------------------------------------
# LLM_PROVIDER options: "auto" | "openai" | "ollama"
#   auto   -> use OpenAI if OPENAI_API_KEY is set, otherwise fall back to Ollama
LLM_PROVIDER=auto

# --- OpenAI (optional, paid) ---
# Only used if a key is present. Do NOT hardcode keys anywhere else.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=                   # optional, for Azure/OpenAI-compatible gateways

# --- Ollama (optional, free / local) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Generation controls
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=800

# -----------------------------------------------------------------------------
# Embeddings provider
# -----------------------------------------------------------------------------
# EMBEDDING_PROVIDER options: "sentence_transformers" | "openai"
EMBEDDING_PROVIDER=sentence_transformers

# SentenceTransformers model (local, free). all-MiniLM-L6-v2 is fast & small (384-dim).
EMBEDDING_MODEL=all-MiniLM-L6-v2

# OpenAI embedding model (only if EMBEDDING_PROVIDER=openai)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# -----------------------------------------------------------------------------
# Vector store
# -----------------------------------------------------------------------------
# VECTOR_BACKEND options: "chroma" (only one implemented; interface is pluggable)
VECTOR_BACKEND=chroma
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION=technical_services

# -----------------------------------------------------------------------------
# Chunking / retrieval tuning
# -----------------------------------------------------------------------------
CHUNK_SIZE=1000                    # characters per chunk
CHUNK_OVERLAP=150                  # character overlap between chunks
RETRIEVAL_TOP_K=4                  # number of chunks to retrieve per question
# Minimum similarity (0..1). Chunks below this are ignored -> drives the refusal behavior.
MIN_RELEVANCE_SCORE=0.25

# -----------------------------------------------------------------------------
# Uploads
# -----------------------------------------------------------------------------
MAX_UPLOAD_MB=25
DATA_DIR=./data
